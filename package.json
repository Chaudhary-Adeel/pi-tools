{
  "name": "pi-coding-toolkit",
  "version": "0.1.0",
  "description": "A batteries-included Pi package: web fetch/search, file I/O, code search, ask-user, and parallel subagent spawning, plus a token-efficient system prompt.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.6.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "install:pi": "bash install.sh",
    "reinstall": "bash install.sh"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "typebox": "^1.3.6"
  }
}
